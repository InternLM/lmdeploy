+torch::Tensor
+Buffer::get_low_latency_dispatch_send_buffer(int num_max_dispatch_tokens_per_rank, int hidden, int num_experts) const {
+#ifndef DISABLE_NVSHMEM
+    EP_HOST_ASSERT(low_latency_mode and hidden == 4096);
+    LowLatencyLayout layout(rdma_buffer_ptr, num_max_dispatch_tokens_per_rank, hidden, num_ranks, num_experts);
+    EP_HOST_ASSERT(layout.total_bytes <= num_rdma_bytes);
+    auto buffer = layout.buffers[low_latency_buffer_idx];
+    // FP8 message: int4 header, packed E4M3 activations, FP32 scales.
+    const int message_bytes = 16 + hidden + hidden / 128 * sizeof(float);
+    return torch::from_blob(buffer.dispatch_rdma_send_buffer,
+                            {num_max_dispatch_tokens_per_rank, message_bytes},
+                            torch::TensorOptions().dtype(torch::kUInt8).device(torch::kCUDA));
+#else
+    EP_HOST_ASSERT(false and "NVSHMEM is disabled during compilation");
+    return {};
+#endif
+}
