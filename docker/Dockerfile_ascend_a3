# DOCKER_BUILDKIT=1 docker build --build-arg ASCEND_DEVICE_TYPE=ascend_a3 \
#     --network=host -t lmdeploy:a3 -f docker/Dockerfile_ascend_a3 .
ARG ASCEND_DEVICE_TYPE=ascend_a3
ARG ASCEND_HUB=quay.io/ascend

FROM ${ASCEND_HUB}/cann:9.1.0-a3-openeuler24.03-py3.12 AS ascend_a3_base

FROM ${ASCEND_DEVICE_TYPE}_base AS builder
ENV DEBIAN_FRONTEND=noninteractive
RUN dnf update -y && \
    dnf install -y jemalloc jemalloc-devel && \
    dnf clean all && rm -rf /var/cache/dnf && \
    python3.12 -m venv /opt/lmdeploy-env

ENV HCCL_CONNECT_TIMEOUT=7200 \
    PYTORCH_NPU_ALLOC_CONF="expandable_segments:True" \
    HCCL_OP_EXPANSION_MODE="AIV" \
    TORCH_DEVICE_BACKEND_AUTOLOAD=0 \
    LMDEPLOY_TARGET_DEVICE=ascend \
    VIRTUAL_ENV=/opt/lmdeploy-env \
    PATH=/opt/lmdeploy-env/bin:${PATH} \
    LD_PRELOAD=/usr/lib64/libjemalloc.so.2

COPY . /opt/lmdeploy
WORKDIR /opt/lmdeploy
RUN --mount=type=cache,target=/root/.cache/pip \
    python -m pip download --no-deps --only-binary=:all: \
        --dest /tmp/ascend-wheels --index-url https://download.pytorch.org/whl/cpu \
        -c requirements/ascend_a3_constraints.txt \
        torch torchvision && \
    python -m pip download --no-deps --only-binary=:all: \
        --dest /tmp/ascend-wheels \
        --index-url https://mirrors.huaweicloud.com/ascend/repos/pypi \
        -r requirements/ascend_kernels.txt && \
    python -m pip install --index-url https://pypi.org/simple \
        --find-links /tmp/ascend-wheels \
        -c requirements/ascend_a3_constraints.txt \
        -r requirements/ascend_kernels.txt . pyarrow && \
    python -m pip check && \
    python -c "import importlib.util; assert importlib.util.find_spec('dlinfer') is None; assert importlib.util.find_spec('triton_ascend_kernels') is None; import lmdeploy, numpy, pandas, pyarrow, ray" && \
    rm -rf /tmp/ascend-wheels
