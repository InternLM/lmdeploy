index 0000000..d93b8d3
--- /dev/null
+++ b/tests/test_public_api.py
@@ -0,0 +1,89 @@
+"""Public wrapper tests that also run without a compiled CUDA extension."""
+
+import importlib.util
+import sys
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import pytest
+import torch
+
+
+@pytest.fixture
+def api(monkeypatch):
+    name = "_flash_kda_api_test"
+    source = Path(__file__).resolve().parents[1] / "flash_kda" / "__init__.py"
+    spec = importlib.util.spec_from_file_location(
+        name, source, submodule_search_locations=[str(source.parent)]
+    )
+    module = importlib.util.module_from_spec(spec)
+    monkeypatch.setitem(sys.modules, name, module)
+    monkeypatch.setitem(sys.modules, name + "._C", SimpleNamespace())
+    native = SimpleNamespace(fwd=Mock(), get_workspace_size=Mock(return_value=256))
+    monkeypatch.setattr(torch.ops, "flash_kda", native)
+    spec.loader.exec_module(module)
+    return module, native
+
+
+@pytest.mark.parametrize("capture", [False, True])
+@pytest.mark.parametrize("reuse_workspace", [False, True])
+@pytest.mark.parametrize("seqlen_dtype", [None, torch.int32, torch.int64])
+def test_public_fwd_passes_checkpoint_buffers(
+    api, capture, reuse_workspace, seqlen_dtype
+):
+    module, native = api
+    q = torch.empty(2 if seqlen_dtype is None else 1, 32, 2, 128, dtype=torch.bfloat16)
+    cu = None if seqlen_dtype is None else torch.tensor([0, 16, 32], dtype=seqlen_dtype)
+    state = torch.empty(2, 2, 128, 128)
+    checkpoint = torch.empty_like(state) if capture else None
+    offsets = (
+        torch.tensor([16, 16], dtype=seqlen_dtype or torch.int64) if capture else None
+    )
+    workspace = torch.empty(256, dtype=torch.uint8) if reuse_workspace else None
+    # Existing positional arguments, including workspace, keep their positions.
+    module.fwd(
+        q,
+        q,
+        q,
+        q,
+        q[..., 0],
+        0.125,
+        q,
+        torch.zeros(2),
+        torch.zeros(2, 128),
+        -5,
+        state,
+        state,
+        cu,
+        workspace,
+        checkpoint_state=checkpoint,
+        checkpoint_offsets=offsets,
+    )
+    native.fwd.assert_called_once()
+    args, kwargs = native.fwd.call_args
+    assert kwargs["checkpoint_state"] is checkpoint
+    assert kwargs["checkpoint_offsets"] is offsets
+    assert kwargs["cu_seqlens"] is cu
+    assert kwargs["initial_state"] is state
+    assert kwargs["final_state"] is state
+    if reuse_workspace:
+        assert args[7] is workspace
+        native.get_workspace_size.assert_not_called()
+    else:
+        native.get_workspace_size.assert_called_once_with(q.size(0) * q.size(1), 2, 2)
+        assert args[7].dtype == torch.uint8
+        assert args[7].numel() == 256
+
+
+@pytest.mark.parametrize("missing", ["checkpoint_state", "checkpoint_offsets"])
+def test_unpaired_checkpoint_rejected_before_allocation(api, missing):
+    module, native = api
+    kwargs = dict(
+        checkpoint_state=torch.empty(1), checkpoint_offsets=torch.tensor([16])
+    )
+    kwargs.pop(missing)
+    with pytest.raises(ValueError, match="provided together"):
+        module.fwd(*([None] * 10), **kwargs)
+    native.fwd.assert_not_called()
+    native.get_workspace_size.assert_not_called()
